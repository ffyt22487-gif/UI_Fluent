TRW_ENDPOINT  = "https://trw.lat/api/bypass"

DATA_FILE = "channels.json"

# ============================================================
# LOAD / SAVE
# ============================================================
def load_channels():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r") as f:
            return json.load(f)
    return {}

def save_channels(data):
    with open(DATA_FILE, "w") as f:
        json.dump(data, f)

channels = load_channels()

# ============================================================
# BOT
# ============================================================
intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    await bot.tree.sync()
    print(f"✅ Bot online: {bot.user}")

# ============================================================
# /set
# ============================================================
@bot.tree.command(name="set", description="ตั้งห้อง bypass (เจ้าของเซิร์ฟเวอร์เท่านั้น)")
@app_commands.describe(channel="เลือกห้องที่ต้องการ")
async def set_channel(interaction: discord.Interaction, channel: discord.TextChannel):
    if interaction.user.id != interaction.guild.owner_id:
        await interaction.response.send_message("❌ เฉพาะเจ้าของเซิร์ฟเวอร์เท่านั้น", ephemeral=True)
        return

    channels[str(interaction.guild_id)] = channel.id
    save_channels(channels)

    await interaction.response.send_message(
        f"✅ ตั้งห้อง bypass เป็น {channel.mention} แล้ว",
        ephemeral=True
    )

# ============================================================
# ON MESSAGE
# ============================================================
@bot.event
async def on_message(message: discord.Message):
    if message.author.bot:
        return

    guild_id = str(message.guild.id) if message.guild else None
    if not guild_id or channels.get(guild_id) != message.channel.id:
        await bot.process_commands(message)
        return

    urls = [w for w in message.content.split() if w.startswith("http://") or w.startswith("https://")]
    if not urls:
        await bot.process_commands(message)
        return

    url = urls[0]
    loading_msg = await message.reply("⏳ กำลัง bypass...")

    try:
        api_url = f"{TRW_ENDPOINT}?apikey={TRW_API_KEY}&url={url}"

        async with aiohttp.ClientSession() as session:
            async with session.get(api_url, timeout=aiohttp.ClientTimeout(total=15)) as resp:
                data = await resp.json()

        if not data or not data.get("success") or not data.get("result"):
            await loading_msg.edit(content=f"❌ bypass ไม่ได้: {data.get('message', 'unknown error')}")
            return

        result = data["result"]

        # ล้าง tuple format
        match = re.match(r"^\(['\"](.+?)['\"],\s*(True|False)\)$", result)
        if match:
            result = match.group(1)

        embed = discord.Embed(title="✅ Bypass สำเร็จ", color=0x2ecc71)
        embed.add_field(name="🔗 ลิงก์เดิม", value=f"`{url[:100]}`", inline=False)
        embed.add_field(name="⚡ ลิงก์ที่ได้", value=result, inline=False)
        embed.set_footer(text="BypassAD • Fast Link Processor")

        await loading_msg.edit(content="", embed=embed)

    except aiohttp.ClientError:
        await loading_msg.edit(content="❌ เชื่อมต่อ API ไม่ได้")
    except Exception as e:
        await loading_msg.edit(content=f"❌ error: {str(e)}")

    await bot.process_commands(message)

bot.run(DISCORD_TOKEN)
